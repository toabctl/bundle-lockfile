{
  // Type check of the JavaScript sources (JSDoc types), no build: `npm run typecheck`
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    // errors from fs and child_process are Node.js errors (e.code): typed as such where it matters
    "useUnknownInCatchVariables": false,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.cjs", "src/**/*.mjs", "src/**/*.d.ts"]
}
