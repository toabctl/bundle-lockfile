{
  // Type check of the JavaScript sources (JSDoc types), no build: `npm run typecheck`
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // strict, all of it: what comes from outside (a bundler's objects, JSON, errors) is unknown until checked
    // (core/values.cjs), what every supported version of a bundler has is typed (src/adapters/*-types.d.ts)
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.cjs", "src/**/*.mjs", "src/**/*.d.ts"]
}
