#!/bin/sh
# bundle-lockfile's node shim. Put its directory first in PATH (PATH=/path/to/bundle-lockfile/bin:$PATH) for builds
# whose scripts overwrite NODE_OPTIONS (cross-env NODE_OPTIONS=..., an inline NODE_OPTIONS=... node ...): every node
# started through PATH gets the --require back, and so does everything it starts (also with process.execPath).
#
# 1. puts --require <register.cjs> into NODE_OPTIONS, unless it is there in any form (also through another path to
#    the same file, e.g. a symlinked install directory, and quoted with spaces) or another copy of bundle-lockfile's
#    register.cjs is (a second --require breaks Next.js 15.0 - 16.3), keeping what else is set
# 2. runs the real node: the first `node` in PATH that is neither this shim (nor a copy of it) nor a script it has
#    already passed through on this start. Package managers and version managers put scripts in front: yarn's
#    temporary `node` runs `exec "<its process.execPath>" "$@"`, which register.cjs points at this shim, so it comes
#    back here and is skipped then; asdf's and nodenv's shims run their node by its path. The scripts passed through
#    are in BUNDLE_LOCKFILE_NODE_SEEN, which register.cjs clears, so that the processes node starts begin anew.
#    Looked up on every start: PATH can change (nvm).
# Without a register.cjs (none next to the shim, or BUNDLE_LOCKFILE_REGISTER names no file) node would build without
# bundle-lockfile, silently missing lockfiles: it fails instead, as bundle-lockfile does (BUNDLE_LOCKFILE_STRICT=0: a
# warning, and node runs without it; BUNDLE_LOCKFILE_DISABLE=all: node runs). Read from the environment only: this
# script does not read the settings file.
set -f # word splitting below, never globbing
self=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
reg=${BUNDLE_LOCKFILE_REGISTER:-} missing=
if [ -z "$reg" ]; then
  d=$(dirname "$self")
  for r in "$d/../src/register.cjs" "$d/../register.cjs"; do
    [ -f "$r" ] && { reg=$(readlink -f "$r" 2>/dev/null || printf '%s' "$r"); break; }
  done
  [ -n "$reg" ] || missing="no register.cjs next to $self (../src/register.cjs or ../register.cjs)"
elif [ ! -f "$reg" ]; then
  missing="BUNDLE_LOCKFILE_REGISTER names no file: $reg"; reg=
fi
if [ -n "$reg" ]; then
  have=
  case "${NODE_OPTIONS:-}" in *"$reg"*) have=1 ;; esac
  if [ -z "$have" ]; then
    # the words as Node splits NODE_OPTIONS: a "..." that the word splitting cut at its spaces is one again
    open=
    for w in ${NODE_OPTIONS:-}; do
      if [ -n "$open" ]; then
        open="$open $w"
        case "$w" in *\"*) w=$open; open= ;; *) continue ;; esac
      else
        case "$w" in *\"*) case "${w#*\"}" in *\"*) ;; *) open=$w; continue ;; esac ;; esac
      fi
      w=${w#--require=}; w=${w#\"}; w=${w%\"}; w=${w#\'}; w=${w%\'}
      case "$w" in
        */register.cjs)
          [ "$(readlink -f "$w" 2>/dev/null)" = "$reg" ] && { have=1; break; }
          # another copy (every release's register.cjs names bundle-lockfile in its first lines)
          case "$(head -c 512 "$w" 2>/dev/null)" in *bundle-lockfile*) have=1; break ;; esac ;;
      esac
    done
  fi
  if [ -z "$have" ]; then
    case "$reg" in *' '*) q="\"$reg\"" ;; *) q=$reg ;; esac
    NODE_OPTIONS="--require $q${NODE_OPTIONS:+ $NODE_OPTIONS}"; export NODE_OPTIONS
  fi
  BUNDLE_LOCKFILE_NODE_SHIM=$self; export BUNDLE_LOCKFILE_NODE_SHIM
else
  # the values as bundle-lockfile reads them (core/config.cjs): case-insensitive, spaces around them ignored
  oifs=$IFS; IFS=" $(printf '\t')"
  n=0; for w in ${BUNDLE_LOCKFILE_STRICT:-}; do n=$((n + 1)); v=$w; done # the whole value, trimmed: one word
  strict=1; [ "$n" = 1 ] && case "$v" in 0|[Ff][Aa][Ll][Ss][Ee]|[Oo][Ff][Ff]) strict= ;; esac
  IFS=" ,$(printf '\t')"
  all=; for w in ${BUNDLE_LOCKFILE_DISABLE:-}; do case "$w" in [Aa][Ll][Ll]) all=1 ;; esac; done
  IFS=$oifs
  if [ -z "$all" ]; then
    if [ -n "$strict" ]; then
      echo "[bundle-lockfile] ERROR: node shim: $missing; set BUNDLE_LOCKFILE_REGISTER (BUNDLE_LOCKFILE_STRICT=0 makes this a warning)" >&2
      exit 1
    fi
    echo "[bundle-lockfile] WARNING: node shim: $missing - node runs without bundle-lockfile" >&2
  fi
fi
oifs=$IFS; IFS=:
for dir in $PATH; do
  node="$dir/node"
  [ -n "$dir" ] && [ -f "$node" ] && [ -x "$node" ] || continue
  case ":${BUNDLE_LOCKFILE_NODE_SEEN:-}:" in *":$node:"*) continue ;; esac
  if [ "$(head -c 2 "$node" 2>/dev/null)" = '#!' ]; then # a script (only then more is read: a binary has NUL bytes)
    case "$(head -c 512 "$node" 2>/dev/null)" in *"bundle-lockfile's node shim"*) continue ;; esac
    [ "$(readlink -f "$node" 2>/dev/null)" = "$self" ] && continue
    BUNDLE_LOCKFILE_NODE_SEEN="${BUNDLE_LOCKFILE_NODE_SEEN:+$BUNDLE_LOCKFILE_NODE_SEEN:}$node"; export BUNDLE_LOCKFILE_NODE_SEEN
  else
    unset BUNDLE_LOCKFILE_NODE_SEEN
  fi
  IFS=$oifs; set +f
  exec "$node" "$@"
done
echo "bundle-lockfile node shim: no node binary in PATH" >&2
exit 127
